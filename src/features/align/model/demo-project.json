  "lines": [
    {
      "id": "line-1",
      "text": "夜风先到",
      "start": 8.0,
      "end": 10.0
    },
    {
      "id": "line-2",
      "text": "把街灯点亮",
      "start": 10.0,
      "end": 12.0
    },
    {
      "id": "line-3",
      "text": "我数着脚步",
      "start": 12.0,
      "end": 14.0
    },
    {
      "id": "line-4",
      "text": "走进旧时光",
      "start": 14.0,
      "end": 16.0
    },
    {
      "id": "line-5",
      "text": "云从山后来",
      "start": 16.0,
      "end": 18.0
    },
    {
      "id": "line-6",
      "text": "带着雨的消息",
      "start": 18.0,
      "end": 20.0
    },
    {
      "id": "line-7",
      "text": "你说别回头",
      "start": 20.0,
      "end": 22.0
    },
    {
      "id": "line-8",
      "text": "路会自己亮起",
      "start": 22.0,
      "end": 24.0
    },
    {
      "id": "line-9",
      "text": "如果星光还在",
      "start": 24.0,
      "end": 26.0
    },
    {
      "id": "line-10",
      "text": "就让它慢慢落",
      "start": 26.0,
      "end": 28.0
    },
    {
      "id": "line-11",
      "text": "我会记得这夜",
      "start": 28.0,
      "end": 30.0
    },
    {
      "id": "line-12",
      "text": "和你的沉默",
      "start": 30.0,
      "end": 32.0
    },
    {
      "id": "line-13",
      "text": "桥段的风",
      "start": 32.0,
      "end": 34.0
    },
    {
      "id": "line-14",
      "text": "吹散了承诺",
      "start": 34.0,
      "end": 36.0
    },
    {
      "id": "line-15",
      "text": "等潮汐退去",
      "start": 36.0,
      "end": 38.0
    },
    {
      "id": "line-16",
      "text": "我再向你走",
      "start": 38.0,
      "end": 40.0
    },
    {
      "id": "line-17",
      "text": "如果星光还在",
      "start": 40.0,
      "end": 42.0
    },
    {
      "id": "line-18",
      "text": "就让它慢慢落",
      "start": 42.0,
      "end": 44.0
    },
    {
      "id": "line-19",
      "text": "我会记得这夜",
      "start": 44.0,
      "end": 46.0
    },
    {
      "id": "line-20",
      "text": "和你的沉默",
      "start": 46.0,
      "end": 48.0
    },
    {
      "id": "line-21",
      "text": "天快亮了",
      "start": 48.0,
      "end": 50.0
    },
    {
      "id": "line-22",
      "text": "我们先别说",
      "start": 50.0,
      "end": 52.0
    }
  ],
